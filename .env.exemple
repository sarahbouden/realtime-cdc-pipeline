# Copy to .env before running `docker compose up`.
# These are local development values only.

# --- PostgreSQL (source database) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=ecommerce_pass

# --- Order simulator ---
SIMULATOR_ORDERS_PER_CYCLE=10
SIMULATOR_CYCLE_SECONDS=5
SIMULATOR_SEED_CUSTOMERS=100
SIMULATOR_SEED_PRODUCTS=50
